{
  "name": "dnd-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "D&D 5e multijugador con GM IA o humano",
  "scripts": {
    "start": "node --env-file=.env src/server/main.ts",
    "dev": "node --watch src/server/main.ts --memoria",
    "dev:neon": "node --env-file=.env --watch src/server/main.ts --demo",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc",
    "seed:molino": "node --env-file=.env db/seed/molino.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
