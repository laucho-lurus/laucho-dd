# Copia a .env y rellena. Nunca subas .env a git.
DATABASE_URL=postgres://usuario:clave@host.neon.tech/neondb?sslmode=require
ANTHROPIC_API_KEY=
# Tope de gasto mensual del GM IA, en USD
AI_MONTHLY_BUDGET_USD=5
# Ruta discreta de la página del GM (crear sala, editor, imágenes). Por defecto /gm.
# No es seguridad: entrar como GM sigue exigiendo el token de la sala.
GM_RUTA=/gm
